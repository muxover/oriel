root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{java,kt,kts,ps1,py}]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.{yml,yaml,json,md,toml,html,css,xml}]
indent_style = space
indent_size = 2
